# Copy to .env and adjust if you need something other than the defaults.
#   cp .env.example .env
# .env is git-ignored - never commit real credentials.

# --- Database (used by docker-compose.yml) ---------------------------------
# The SA password for the local SQL Server container.
MSSQL_SA_PASSWORD=Local_Dev_Password1

# --- Backend ---------------------------------------------------------------
# ASP.NET Core reads configuration from environment variables, where "__" means
# "nested section". Setting this overrides ConnectionStrings:Default from
# apps/api/src/SupportDesk.Presentation/appsettings.Development.json - useful if you run SQL Server elsewhere,
# or on another port.
ConnectionStrings__Default=Server=localhost,1433;Database=SupportDesk;User Id=sa;Password=Local_Dev_Password1;TrustServerCertificate=True;Encrypt=False

# Key the API signs sign-in tokens with (HMAC-SHA256, at least 32 bytes). Development has a
# throwaway one in appsettings.Development.json; anywhere else, set a long random value here
# or in the host's secret store. The API refuses to start without one.
#   Generate: openssl rand -base64 48
# Jwt__SigningKey=replace-with-a-long-random-value-at-least-32-bytes

# Development turns on Swagger, the automatic migration and the demo seed data.
ASPNETCORE_ENVIRONMENT=Development

# --- Development sign-in (not a setting - documented here so it is easy to find) ---
# In Development the API seeder gives every seeded agent this password, hashed at seed time:
#   email:    any agent, e.g. sara.lindqvist@northwind-support.example
#   password: LocalDevOnly-NotARealPassword-1
# It is a local fixture, not a real credential. Yuki Tanaka is inactive and cannot sign in.
# Agents loaded by db/seed.sql have no password until the API's seeder has run once.
