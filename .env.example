# Copy to .env - the values below work as they are for local development:
#   cp .env.example .env
#   docker compose up --build
# .env is git-ignored. Every value here is a LOCAL FIXTURE: never use any of them in production.

# --- Database (docker-compose.yml) -------------------------------------------
# The SA password for the local SQL Server container. The api service builds its connection
# string from it, reaching SQL Server by its service name (Server=sqlserver).
MSSQL_SA_PASSWORD=Local_Dev_Password1

# --- API container (docker-compose.yml) --------------------------------------
# Environment name the API container runs as. Production by default; Development also turns
# on Swagger (http://localhost:5080/swagger). Migrating and seeding do not depend on it - the
# compose file switches those on with Database__MigrateOnStartup / Database__SeedDemoData.
API_ENVIRONMENT=Production

# Key the API signs sign-in tokens with (HMAC-SHA256, at least 32 bytes). LOCAL FIXTURE ONLY -
# a real deployment sets its own long random value from the host's secret store.
#   Generate one: openssl rand -base64 48
Jwt__SigningKey=local-dev-only-signing-key-not-for-production-0123456789

# The password the seeder gives every seeded agent, hashed with its own salt at seed time
# (only the hash reaches the database). LOCAL FIXTURE ONLY - the development sign-in:
#   email:    any agent, e.g. sara.lindqvist@northwind-support.example
#   password: the value below
# Yuki Tanaka is inactive and cannot sign in. The seeder only sets a password for agents that
# have none, so after changing it run `docker compose down -v` (or `npm run db:reset`).
Seed__AgentPassword=LocalDevOnly-NotARealPassword-1

# --- API on the host (npm run api / dotnet run) ------------------------------
# Not read by docker compose or by dotnet run. Export it only to point a host-run API at another
# SQL Server; by default the connection string comes from appsettings.Development.json and the
# key and seed password from dotnet user-secrets (see README.md).
# ConnectionStrings__Default=Server=localhost,1433;Database=SupportDesk;User Id=sa;Password=Local_Dev_Password1;TrustServerCertificate=True;Encrypt=False
